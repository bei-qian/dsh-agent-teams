{
  "name": "dsh-agent-teams",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "BMad 小队（Squad）插件：在 DSH 内置 Agent Teams 之上提供 Leader + BMad 角色 Roster + 小队指令，并随包携带 BMad 技能。",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "agent-teams",
    "squad",
    "bmad"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json",
    "./rows/squad-lead": "./rows/squad-lead/index.js",
    "./rows/squad-lead/locale/*.json": "./rows/squad-lead/locale/*.json",
    "./rows/squad-lead/icon": "./icon.svg",
    "./rows/analyst": "./rows/analyst/index.js",
    "./rows/analyst/locale/*.json": "./rows/analyst/locale/*.json",
    "./rows/analyst/icon": "./icon.svg",
    "./rows/pm": "./rows/pm/index.js",
    "./rows/pm/locale/*.json": "./rows/pm/locale/*.json",
    "./rows/pm/icon": "./icon.svg",
    "./rows/po": "./rows/po/index.js",
    "./rows/po/locale/*.json": "./rows/po/locale/*.json",
    "./rows/po/icon": "./icon.svg",
    "./rows/ux": "./rows/ux/index.js",
    "./rows/ux/locale/*.json": "./rows/ux/locale/*.json",
    "./rows/ux/icon": "./icon.svg",
    "./rows/architect": "./rows/architect/index.js",
    "./rows/architect/locale/*.json": "./rows/architect/locale/*.json",
    "./rows/architect/icon": "./icon.svg",
    "./rows/dev": "./rows/dev/index.js",
    "./rows/dev/locale/*.json": "./rows/dev/locale/*.json",
    "./rows/dev/icon": "./icon.svg",
    "./rows/tea": "./rows/tea/index.js",
    "./rows/tea/locale/*.json": "./rows/tea/locale/*.json",
    "./rows/tea/icon": "./icon.svg"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent-preset": "^0.2.2-rc.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    },
    "manifestVersion": 1
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "cordis.patch.tmpl.yml",
    "prompts",
    "skills",
    "playbooks",
    "capabilities",
    "rows",
    "scripts",
    "locale",
    "icon.svg",
    "examples",
    "README.md",
    "DESIGN.md",
    "SETUP.md",
    "ROADMAP.md",
    "ATTRIBUTION.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build:patch": "node scripts/build_patch.mjs",
    "verify": "node scripts/verify.mjs",
    "validate": "node scripts/squad_validate.mjs",
    "validate:sample": "node scripts/squad_validate.mjs examples/bmad-output",
    "test:client": "node scripts/test_client.mjs"
  }
}
