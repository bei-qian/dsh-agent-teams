{
  "name": "dsh-olympus",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Olympus Squad 插件：在 DSH 内置 Agent Teams 之上提供 Hermes + 7 位希腊神话花名专家成员的小队编制与工作法（方法参考 BMad Method）。",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "agent-teams",
    "squad",
    "olympus"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json",
    "./presets/squad-lead": "./presets/squad-lead/index.js",
    "./presets/squad-lead/locale/*.json": "./presets/squad-lead/locale/*.json",
    "./presets/squad-lead/icon": "./icon.svg",
    "./presets/analyst": "./presets/analyst/index.js",
    "./presets/analyst/locale/*.json": "./presets/analyst/locale/*.json",
    "./presets/analyst/icon": "./icon.svg",
    "./presets/pm": "./presets/pm/index.js",
    "./presets/pm/locale/*.json": "./presets/pm/locale/*.json",
    "./presets/pm/icon": "./icon.svg",
    "./presets/po": "./presets/po/index.js",
    "./presets/po/locale/*.json": "./presets/po/locale/*.json",
    "./presets/po/icon": "./icon.svg",
    "./presets/ux": "./presets/ux/index.js",
    "./presets/ux/locale/*.json": "./presets/ux/locale/*.json",
    "./presets/ux/icon": "./icon.svg",
    "./presets/architect": "./presets/architect/index.js",
    "./presets/architect/locale/*.json": "./presets/architect/locale/*.json",
    "./presets/architect/icon": "./icon.svg",
    "./presets/dev": "./presets/dev/index.js",
    "./presets/dev/locale/*.json": "./presets/dev/locale/*.json",
    "./presets/dev/icon": "./icon.svg",
    "./presets/tea": "./presets/tea/index.js",
    "./presets/tea/locale/*.json": "./presets/tea/locale/*.json",
    "./presets/tea/icon": "./icon.svg"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent-preset": "^0.2.2-rc.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    },
    "manifestVersion": 1
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "cordis.patch.tmpl.yml",
    "persona",
    "playbooks",
    "capabilities",
    "presets",
    "scripts",
    "locale",
    "icon.svg",
    "examples",
    "README.md",
    "DESIGN.md",
    "SETUP.md",
    "ROADMAP.md",
    "ATTRIBUTION.md",
    "CHANGELOG.md",
    "LICENSE",
    "LICENSE-BMAD-METHOD.txt"
  ],
  "scripts": {
    "build:patch": "node scripts/build_patch.mjs",
    "verify": "node scripts/verify.mjs",
    "validate": "node scripts/squad_validate.mjs",
    "validate:sample": "node scripts/squad_validate.mjs examples/bmad-output",
    "validate:presets": "node scripts/check_presets.mjs",
    "check:refs": "node scripts/check_gate_cmd.mjs",
    "check:pack": "node scripts/check_pack.mjs",
    "test:client": "node scripts/test_client.mjs",
    "check:naming": "node scripts/check_naming.mjs",
    "check:prototype": "node scripts/check_prototype.mjs"
  }
}
